# Last.fm API Credentials
# Get them from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_api_key_here
LASTFM_API_SECRET=your_api_secret_here

# Your Last.fm account details
LASTFM_USERNAME=your_lastfm_username

# Choose ONE of the following auth methods:
# Method A: Plaintext password (script will automatically hash it and generate a session key)
LASTFM_PASSWORD=your_lastfm_password

# Method B: Pre-generated session key (preferred, avoids storing password in plain text)
# LASTFM_SESSION_KEY=your_session_key_here
